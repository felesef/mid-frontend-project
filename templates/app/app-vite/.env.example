# Copy to .env for local development: cp .env.example .env

# API base URL — NO trailing slash, NO /api suffix (app adds /api/events, etc.)
#
# Local:
VITE_API_URL=http://localhost:3001
#
# Production (Vercel): set in Vercel → Environment Variables to your Render URL, e.g.
# VITE_API_URL=https://hyf-events-api.onrender.com

# Local mock API port (Render uses PORT instead)
API_PORT=3001

# Vite dev server port
PORT=5173
